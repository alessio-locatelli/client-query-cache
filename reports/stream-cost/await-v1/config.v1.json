    "resample_count": 46656,
    "resampling": "Enumerate all 6**6 ordered draws with replacement of six paired blocks; identical multiplicity vectors may be aggregated with their multinomial weights. Preserve all event and shutdown observations within every sampled block.",
    "statistic": "Log of pooled candidate/reference p95 for lag; log of summed candidate/reference CPU seconds for matched active windows; log of (candidate total cost / candidate total elapsed) / (reference total cost / reference total elapsed) for idle rates; log of pooled p95 seconds for absolute shutdown. Use nearest-rank p95.",
    "one_sided_p_value": "(1 + weighted_count(t_star - t <= t - log(limit))) / (1 + resample_count); t is the observed log statistic. This is the null-centered lower-tail test against the registered upper limit.",
    "upper_bound": "Basic bootstrap upper bound exp(t - quantile_alpha(t_star - t)); quantiles use the weighted nearest rank. Report nominal alpha=.05 and the threshold-specific Holm step alpha=.05/(family_size-rank+1). A gate passes only if its Holm adjusted p-value is <= .05 and its upper bound is <= its limit.",
    "multiplicity": "Holm-Bonferroni over every comparison in comparisons, including failed/unresolved comparisons assigned p=1. Sort ties in configuration order; adjusted p is the running maximum of min(1, (family_size-rank+1)*p).",
    "resolution": {
      "server_cpu_rate": 1e-6,
      "client_cpu_rate": 1e-6,
      "byte_rate": 1.0,
      "lag_p95_seconds": 1e-6,
      "shutdown_p95_seconds": 1e-6,
      "server_cpu_seconds": 1e-6,
      "client_cpu_seconds": 1e-6
    },
    "unresolved_denominator": "A reference statistic at or below resolution in the observed sample or any resample makes the comparison unresolved (p=1). Nonpositive candidate statistics are also unresolved; never substitute an epsilon."
