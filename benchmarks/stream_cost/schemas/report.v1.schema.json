{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mongo-client-cache:benchmarks:stream-cost:report:v1",
  "title": "Stream cost benchmark report (v1)",
  "type": "object",
  "required": [
    "schema_version",
    "identity",
    "environment",
    "workload",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "identity": {
      "type": "object",
      "required": [
        "revision",
        "library_version",
        "python_version",
        "pymongo_version"
      ],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "library_version": { "type": "string", "minLength": 1 },
        "python_version": { "type": "string", "minLength": 1 },
        "pymongo_version": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "mongodb_version",
        "topology",
        "member_count",
        "resource_limits"
      ],
      "properties": {
        "mongodb_version": { "type": "string", "minLength": 1 },
        "topology": { "type": "string", "minLength": 1 },
        "member_count": { "type": "integer", "minimum": 1 },
        "resource_limits": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "workload": {
      "type": "object",
      "required": ["name", "parameters"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "description"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
