[run]
plugins = covdefaults
# coverage.py 7.16.1: https://coverage.readthedocs.io/en/latest/config.html#run-concurrency
# The default is thread. We override it because benchmarks spawn measured workers.
concurrency = multiprocessing
# coverage.py 7.16.1: https://coverage.readthedocs.io/en/latest/config.html#run-sigterm
# The default is false. We override it to retain measurements from terminated workers.
sigterm = true
omit =
    tests/e2e/*
    tests/memory/*
    scripts/*
    tests/benchmark/real_server/test_cache_benefit.py

[report]
exclude_also =
    \# pragma: lax no cover
