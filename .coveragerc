[run]
plugins = covdefaults
# The default is thread (https://coverage.readthedocs.io/en/7.16.1/config.html#run-concurrency).
# We override it because spawned benchmark workers need multiprocessing measurement while thread
# measurement is retained.
concurrency =
    multiprocessing
    thread
# The default is false (https://coverage.readthedocs.io/en/7.16.1/config.html#run-sigterm).
# We override it because measurements from terminated workers must be retained.
sigterm = true
omit =
    tests/e2e/*
    tests/memory/*
    scripts/*
    # Performance acceptance harnesses run without instrumentation.
    benchmarks/public_shared_cache.py
    benchmarks/implementation.py
    benchmarks/cached_hit_latency.py
    research/process_memory/measure.py
    research/invalidation_scope/*
    research/native_build_profile/*
    research/native_local_integration/*
    tests/benchmark/real_server/test_cache_benefit.py

[report]
exclude_also =
    \# pragma: lax no cover
