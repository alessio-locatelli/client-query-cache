from typing import final

@final
class Payload:
    @property
    def token(self) -> int: ...

@final
class OwnerIndex:
    def __init__(
        self,
        slots: int,
        arena_bytes: int,
        databases: int,
        namespaces: int,
        incarnation: int,
        expiry_ns: int,
    ) -> None: ...
    def reader_descriptor(self) -> int: ...
    def store(self, payload: bytes) -> Payload | None: ...
    def release(self, payload: Payload) -> None: ...
    def snapshot(self, payload: Payload) -> bytes | None: ...
    def publish(
        self,
        database: int,
        namespace: int,
        epoch: int,
        identity: bytes,
        shape: bytes,
        payload: Payload,
    ) -> int | None: ...
    def unpublish(self, payload: Payload) -> bool: ...
    def published(self) -> int: ...
    def set_available(self, database: int, available: bool) -> None: ...
    def set_progress(self, database: int, monotonic_ns: int) -> None: ...
    def set_epoch(self, namespace: int, epoch: int) -> None: ...
    def session_ring(self, tokens: int) -> SessionRing: ...
    def serve(self, path: str) -> EchoOwner: ...

@final
class SessionRing:
    def descriptor(self) -> int: ...
    def close_descriptor(self) -> None: ...
    def drain(self) -> list[int]: ...
    def dropped(self) -> int: ...

@final
class ReaderIndex:
    def __init__(self, index_descriptor: int, ring_descriptor: int) -> None: ...
    @property
    def incarnation(self) -> int: ...
    @property
    def detached(self) -> bool: ...
    def lookup(
        self, database: int, namespace: int, epoch: int, identity: bytes, shape: bytes
    ) -> bytes | None: ...
    def detach(self) -> None: ...
    def dropped(self) -> int: ...

@final
class EchoOwner:
    def close(self) -> None: ...
