{
  "globs": [
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
  ],
  // markdownlint-cli2 0.23.3: https://github.com/DavidAnson/markdownlint-cli2/blob/v0.23.3/schema/markdownlint-cli2-config-schema.json
  // The default is false. We override it because quality logs should show diagnostics without a repeated tool banner.
  "noBanner": true,
  "ignores": ["specifications/**", "site/**", ".cache/**"],
  "config": {
    // markdownlint 0.41.1 rules: https://github.com/DavidAnson/markdownlint/blob/v0.41.1/doc/md013.md
    // The default is an 80-character limit. We override it because Markdown paragraphs, tables, and evidence links use their natural lengths.
    "line-length": false,
  },
  "overrides": [
    {
      "filter": ["CHANGELOG.md"],
      "config": {
        // https://github.com/DavidAnson/markdownlint/blob/v0.41.1/doc/md024.md
        // The default is false. We override it because changelog sections repeat headings across releases while sibling duplicates remain errors.
        "no-duplicate-heading": { "siblings_only": true },
      },
      "combine": "merge",
    },
    {
      "filter": ["CLAUDE.md", "AGENTS.md"],
      "config": {
        // https://github.com/DavidAnson/markdownlint/blob/v0.41.1/doc/md041.md
        // The default is true. We override it because agent instruction files begin with sections rather than a document title.
        "first-line-heading": false,
      },
      "combine": "merge",
    },
  ],
}
