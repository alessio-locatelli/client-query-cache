{
  "globs": [
    "README.md",
    "AGENTS.md",
    "CLAUDE.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
  ],
  "noBanner": true,
  "ignores": ["specifications/**", "site/**", ".cache/**"],
  "config": {
    "line-length": false,
  },
  "overrides": [
    {
      "filter": ["CHANGELOG.md"],
      "config": {
        "no-duplicate-heading": { "siblings_only": true },
      },
      "combine": "merge",
    },
    {
      "filter": ["CLAUDE.md", "AGENTS.md"],
      "config": {
        "first-line-heading": false,
      },
      "combine": "merge",
    },
  ],
}
