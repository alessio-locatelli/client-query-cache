{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "customManagers:dockerfileVersions",
    "customManagers:githubActionsVersions",
  ],
  enabledManagers: ["custom.regex", "github-actions", "pyenv"],
  schedule: ["before 4am on the first day of the month"],
  minimumReleaseAge: "7 days",
  minimumReleaseAgeBehaviour: "timestamp-optional",
  automerge: false,
  lockFileMaintenance: {
    enabled: false,
  },
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: [
        "/^tests/conftest\\.py$/",
        "/^benchmarks/stream_cost/topology\\.py$/",
      ],
      matchStrings: [
        '# renovate: datasource=docker depName=mongo versioning=docker\\n[ \\t]*(?:MONGODB_IMAGE = |container = DockerContainer\\()"mongo:(?<currentValue>[^"\\s]+)"',
      ],
      datasourceTemplate: "docker",
      depNameTemplate: "mongo",
      versioningTemplate: "docker",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^Containerfile$/"],
      matchStrings: [
        "# renovate-taplo: datasource=github-release-attachments depName=tamasfe/taplo\\nARG TAPLO_TOOL_VERSION=(?<currentValue>[^\\s]+)\\n\\nADD --checksum=sha256:(?<currentDigest>[a-f0-9]{64}) https://github.com/tamasfe/taplo/releases/download/[^/]+/taplo-linux-x86_64.gz /tmp/taplo.gz",
      ],
      datasourceTemplate: "github-release-attachments",
      depNameTemplate: "tamasfe/taplo",
      versioningTemplate: "semver",
      autoReplaceStringTemplate: "# renovate-taplo: datasource=github-release-attachments depName=tamasfe/taplo\nARG TAPLO_TOOL_VERSION={{{newValue}}}\n\nADD --checksum=sha256:{{{newDigest}}} https://github.com/tamasfe/taplo/releases/download/{{{newValue}}}/taplo-linux-x86_64.gz /tmp/taplo.gz",
    },
  ],
  packageRules: [
    {
      matchManagers: ["github-actions"],
      matchDepTypes: ["!uses-with"],
      enabled: false,
    },
    {
      matchPackageNames: ["mongo"],
      allowedVersions: "/^8\\.0\\.\\d+-noble$/",
      groupName: "MongoDB test and benchmark image",
    },
    {
      matchManagers: ["pyenv"],
      allowedVersions: "/^3\\.14\\.\\d+$/",
    },
    {
      matchPackageNames: ["node"],
      allowedVersions: "/^24(?:\\.|$)/",
    },
    {
      matchPackageNames: ["prek"],
      matchDatasources: ["pypi"],
      groupName: "Prek CI and container",
    },
  ],
}
